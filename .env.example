# Porta exposta do serviço FastAPI (host:container).
APP_PORT=8000

# Banco de dados, em partes separadas (host, porta, usuário, senha, nome).
# Por padrão aponta pro Postgres embutido no compose (serviço `db`, só sobe
# com `--profile local-db`). Pra usar um Postgres seu (produção, RDS, outro
# servidor), sobrescreva essas variáveis -- nesse caso não precisa subir o
# serviço `db` nem passar --profile local-db.
APP_DB_HOST=db
APP_DB_PORT=5432
APP_DB_USER=cnpj
APP_DB_PASSWORD=cnpj
APP_DB_NAME=cnpj
