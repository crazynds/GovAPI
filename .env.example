# Porta exposta do serviço FastAPI (host:container).
APP_PORT=8000

# Espelho público dos Dados Abertos de CNPJ da Receita Federal.
APP_OPEN_DATA_URL=https://dados-abertos-rf-cnpj.casadosdados.com.br/arquivos

# Banco de dados. Por padrão aponta pro Postgres embutido no compose
# (serviço `db`, só sobe com `--profile local-db`). Pra usar um Postgres
# seu (produção, RDS, outro servidor), descomente e aponte pra ele -- nesse
# caso não precisa subir o serviço `db` nem passar --profile local-db.
# APP_DATABASE_URL=postgresql+psycopg2://usuario:senha@meu-servidor:5432/cnpj
